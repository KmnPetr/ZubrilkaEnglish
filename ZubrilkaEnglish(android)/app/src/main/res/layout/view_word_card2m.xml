<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:visibility="visible">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bac26card"
        android:scaleType="fitXY"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="start"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/numCorrAnsv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="numCorrAnsv"
                android:textColor="#4CAF50"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="statusCard"
                android:textSize="12sp"/>
        </LinearLayout>

        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.4"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="5dp"
            android:gravity="center">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="5dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/foreignWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="Foreign Word"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <com.zubrilka.zubrilkaenglish.utils.ui.CustImageButton
                    android:id="@+id/soundButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="3dp"
                    android:padding="0dp"
                    app:backgroundColor="#00FFFFFF"
                    app:cornerRadius="10dp"
                    app:borderWidth="1dp"
                    app:borderColor="@color/borderSoundButton"
                    app:drawable="@drawable/sound"
                    app:imageSize="15dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/transcription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="[transcription]"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:orientation="vertical"
            android:gravity="center">

            <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
                android:id="@+id/variant0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_margin="3dp"
                app:backgroundColor="@color/white"
                app:cornerRadius="7dp"
                app:borderWidth="1dp"
                app:borderColor="#7E7E7E"
                app:textSize="14sp"
                app:text="variant0"
                app:textStyle="italic"
                app:fontFamily="sans-serif"/>
            <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
                android:id="@+id/variant1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_margin="3dp"
                app:backgroundColor="#FF7B3D"
                app:cornerRadius="7dp"
                app:borderWidth="1dp"
                app:borderColor="#7E7E7E"
                app:textSize="14sp"
                app:text="variant1"
                app:textStyle="italic"
                app:fontFamily="sans-serif"/>
            <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
                android:id="@+id/variant2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_margin="3dp"
                app:backgroundColor="@color/white"
                app:cornerRadius="7dp"
                app:borderWidth="1dp"
                app:borderColor="#7E7E7E"
                app:textSize="14sp"
                app:text="variant2"
                app:textStyle="italic"
                app:fontFamily="sans-serif"/>
            <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
                android:id="@+id/variant3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_margin="3dp"
                app:backgroundColor="#B4F469"
                app:cornerRadius="7dp"
                app:borderWidth="1dp"
                app:borderColor="#7E7E7E"
                app:textSize="14sp"
                app:text="variant3"
                app:textStyle="italic"
                app:fontFamily="sans-serif"/>
        </LinearLayout>

        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.6"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="left"
            android:layout_margin="5dp">

            <com.zubrilka.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/optionsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#00FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/three_dots"
                app:imageSize="30dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>