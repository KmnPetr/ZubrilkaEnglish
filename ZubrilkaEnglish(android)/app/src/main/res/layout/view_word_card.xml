<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="start"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/numCorrAnsv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="numCorrAnsv"
                android:textColor="#4CAF50"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="statusCard"
                android:textSize="12sp"/>
        </LinearLayout>

        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:id="@+id/foreignWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="Foreign Word"
                android:gravity="center"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/transcription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="[transcription]"/>
            <TextView
                android:id="@+id/translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="перевод"
                android:gravity="center"
                android:textStyle="italic"
                android:textSize="24sp"
                android:visibility="invisible"/>
        </LinearLayout>
        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/sleepDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_margin="10dp"
                android:layout_marginHorizontal="2dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/textDialog"
                        android:textSize="10sp"
                        android:text="TextView"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="3"
                        android:valueFrom="0"
                        android:valueTo="6"
                        app:thumbRadius="6dp"
                        app:trackHeight="3dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">
                        <com.example.zubrilkaenglish.utils.ui.CustButton
                            android:id="@+id/btnCansel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:padding="10dp"
                            android:paddingEnd="25dp"
                            app:backgroundColor="#B6B6B6"
                            app:cornerRadius="7dp"
                            app:borderWidth="1dp"
                            app:borderColor="#7E7E7E"
                            app:textColor="@color/white"
                            app:textSize="12sp"
                            app:text="Cansel"
                            app:textStyle="bold_italic"
                            app:fontFamily="sans-serif"/>
                        <com.example.zubrilkaenglish.utils.ui.CustButton
                            android:id="@+id/btnYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:paddingEnd="40dp"
                            android:layout_marginEnd="20dp"
                            app:backgroundColor="#ACD35D"
                            app:cornerRadius="7dp"
                            app:borderWidth="1dp"
                            app:borderColor="#7E7E7E"
                            app:textColor="@color/white"
                            app:textSize="12sp"
                            app:text="Yes"
                            app:textStyle="bold_italic"
                            app:fontFamily="sans-serif"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="5dp">

            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/optionsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/three_dots"
                app:imageSize="30dp" />

            <!--распорочка-->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/lookButton"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/eye_small"
                app:imageSize="35dp" />
            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/noButton"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/red_cross_button_small"
                app:imageSize="30dp" />
            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/yesButton"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/check_mark3_small"
                app:imageSize="30dp" />
        </LinearLayout>

        </LinearLayout>

</androidx.cardview.widget.CardView>