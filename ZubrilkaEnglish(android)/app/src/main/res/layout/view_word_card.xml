<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="start"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/numCorrAnsv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="numCorrAnsv"
                android:textColor="#4CAF50"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="statusCard"
                android:textSize="12sp"/>
        </LinearLayout>

        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:id="@+id/foreignWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="Foreign Word"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/transcription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="[transcription]"/>
            <TextView
                android:id="@+id/translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="перевод"
                android:textStyle="italic"
                android:textSize="24sp"
                android:visibility="invisible"/>
        </LinearLayout>

        <!--распорочка-->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="5dp">

            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/optionsButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/three_dots"
                app:imageSize="40dp" />

            <!--распорочка-->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/lookButton"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/eye_small"
                app:imageSize="45dp" />
            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/noButton"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/red_cross_button_small"
                app:imageSize="40dp" />
            <com.example.zubrilkaenglish.utils.ui.CustImageButton
                android:id="@+id/yesButton"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:padding="0dp"
                app:backgroundColor="#99FFFFFF"
                app:cornerRadius="10dp"
                app:borderWidth="1dp"
                app:borderColor="@color/myGray"
                app:drawable="@drawable/check_mark3_small"
                app:imageSize="40dp" />
        </LinearLayout>

        </LinearLayout>

</androidx.cardview.widget.CardView>