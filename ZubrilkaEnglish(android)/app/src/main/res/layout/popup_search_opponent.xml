<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="#ECEBE9"
    app:cardCornerRadius="@dimen/popupCornerRadius"
    android:layout_marginHorizontal="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <com.zubrilka.zubrilkaenglish.utils.ui.CustImageButton
            android:id="@+id/info_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="end"
            app:backgroundColor="#00FFFFFF"
            app:cornerRadius="10dp"
            app:borderWidth="1dp"
            app:borderColor="#00FFFFFF"
            app:drawable="@drawable/info_icon3"
            app:imageSize="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:layout_gravity="center"
            android:text="Поиск соперника!"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/blockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ожидание: "/>
            <TextView
                android:id="@+id/waitingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/typeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" сек."/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сейчас онлайн: "/>

                <TextView
                    android:id="@+id/countPlayers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Незаняты: "/>

                <TextView
                    android:id="@+id/notInGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Боты: "/>

                <TextView
                    android:id="@+id/countBots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text=""
                    android:textStyle="bold"/>
                <CheckBox
                    android:id="@+id/loyalToBots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="играть с ботом" />
            </LinearLayout>





        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
                android:id="@+id/buttonNextRound"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="16dp"
                app:backgroundColor="#81C100"
                app:cornerRadius="7dp"
                app:borderWidth="1dp"
                app:borderColor="#33691E"
                app:textColor="@color/white"
                app:textSize="14sp"
                app:text="Начать!"
                app:textStyle="bold_italic"
                app:fontFamily="sans-serif"/>

        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>