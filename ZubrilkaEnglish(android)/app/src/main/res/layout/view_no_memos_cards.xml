<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Вы можете добавить напоминания о изучении карточек. \n Это позволит вам более регулярно тренировать слова в удобное для вас время..."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:padding="5dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text">

        <com.zubrilka.zubrilkaenglish.utils.ui.CustButton
            android:id="@+id/goToMemos"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:paddingEnd="35dp"
            app:backgroundColor="#B6B6B6"
            app:borderColor="#7E7E7E"
            app:borderWidth="1dp"
            app:cornerRadius="7dp"
            app:fontFamily="sans-serif"
            app:text="Перейти"
            app:textColor="@color/white"
            app:textSize="12sp"
            app:textStyle="bold_italic" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>